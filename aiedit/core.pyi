    "Polisher",
    "SeedGenerator",
]

class BFKmerModel(KmerModel):
    def __init__(self, seeds_bf_path: str, kmers_bf_path: str) -> None: ...
    def get_kmer_size(self) -> int: ...
    def get_kmers_fpr(self) -> float: ...
    def get_num_hashes(self) -> int: ...
    def get_seeds(self) -> list[str]: ...
    def get_seeds_fpr(self) -> float: ...
    def get_size(self) -> int: ...
    def mean_score(self, arg0: str) -> float: ...
    def score(self, hashes: numpy.ndarray[numpy.uint64]) -> float: ...

class Buffer2D:
    def __getitem__(self, arg0: tuple[int, int]) -> float: ...
    def __init__(self, arg0: int, arg1: int) -> None: ...
    def __setitem__(self, arg0: tuple[int, int], arg1: float) -> None: ...
    @property
    def num_cols(self) -> int: ...
    @property
    def num_rows(self) -> int: ...

class CBFKmerModel(KmerModel):
    @typing.overload
    def __init__(
        self, seeds_bf_path: str, kmers_bf_path: str, hist_path: str
    ) -> None: ...
    @typing.overload
    def __init__(self, seeds_bf_path: str, kmers_bf_path: str) -> None: ...
    def get_kmer_size(self) -> int: ...
    def get_kmers_fpr(self) -> float: ...
    def get_num_hashes(self) -> int: ...
    def get_seeds(self) -> list[str]: ...
    def get_seeds_fpr(self) -> float: ...
    def get_size(self) -> int: ...
    def mean_score(self, arg0: str) -> float: ...
    def score(self, hashes: numpy.ndarray[numpy.uint64]) -> float: ...

class Edit:
    edited: str
    i_try: int
    kmer_score: float
    model_confidence: float
    num_kmers: int
    position: int
    status: EditStatus
    type: EditType
    def __init__(self) -> None: ...

class EditList:
